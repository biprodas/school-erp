NODE_ENV=development
HOST=localhost
PORT=3900

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=school_erp
# true in dev auto-syncs public + tenant schemas
DB_SYNC=false
DB_LOGGING=false
DB_SSL=false
DB_TENANT_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=10000
DB_MAX_LIFETIME=1800000

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# Redis (docker compose; not consumed by the app yet)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Mailer (SMTP)
# Defaults target Mailpit locally (localhost:1025, no auth). For real sending,
# point MAIL_HOST/MAIL_USER/MAIL_PASS at your provider's SMTP credentials.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=School ERP
MAIL_FROM_ADDRESS=no-reply@school-erp.local
# Frontend base URL used to build activation / password-reset links.
APP_URL=http://localhost:3000
# Platform root domain — tenant email links are built as {slug}.{ROOT_DOMAIN}
ROOT_DOMAIN=lvh.me

# CORS (comma-separated origins; omit to allow all in development)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Rate limiting (global throttler; per-tenant + per-user/IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Health checks
HEALTH_DISK_PATH=/
HEALTH_DISK_THRESHOLD=0.9
HEALTH_MEMORY_HEAP_BYTES=314572800
HEALTH_MEMORY_RSS_BYTES=524288000