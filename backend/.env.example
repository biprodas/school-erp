NODE_ENV=development
HOST=localhost
PORT=3900

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Restricted role the tenant pool connects as, so Postgres row-level security
# isolates organizations. Created automatically in dev; create it yourself in
# production (LOGIN NOSUPERUSER NOBYPASSRLS, not the table owner).
DB_APP_USERNAME=school_erp_app
DB_APP_PASSWORD=school_erp_app
DB_NAME=school_erp
# true in dev auto-syncs public + tenant schemas
DB_SYNC=false
DB_LOGGING=false
DB_SSL=false
DB_TENANT_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=10000
DB_MAX_LIFETIME=1800000

# JWT
JWT_SECRET=your-super-secret-jwt-key
# Access-token lifetime. Set 15m once web-2's session layer (M2 in
# doc/frontend-implementation-plan.md) refreshes tokens; the old frontend/
# doesn't refresh, so it stays long until then.
JWT_EXPIRES_IN=7d
# Refresh-token lifetime (rotated on every refresh)
JWT_REFRESH_TTL=30d

# Background jobs: BullMQ on Redis (docker compose). QUEUE_DRIVER=inline
# runs jobs in-process instead (the default under NODE_ENV=test).
REDIS_URL=redis://localhost:6379
# QUEUE_DRIVER=bullmq
# QUEUE_CONCURRENCY=4

# Object storage (S3-compatible; MinIO in docker compose, console :9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=school-erp
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Signed download URL lifetime (seconds) and the upload size cap (bytes)
S3_SIGNED_URL_TTL=300
UPLOAD_MAX_BYTES=10485760

# PDF rendering (Puppeteer's bundled Chrome unless PDF_CHROME_PATH is set)
PDF_CONCURRENCY=4
# PDF_CHROME_PATH=/usr/bin/chromium
# Only for containers running Chrome as root:
# PDF_NO_SANDBOX=true

# Field-level encryption (NID, health, bank accounts): <keyId>:<base64 32 bytes>.
# Generate: node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Required in production. To rotate, set a new key and move the old one to
# FIELD_ENCRYPTION_OLD_KEYS (comma-separated) so existing values stay readable.
# FIELD_ENCRYPTION_KEY=k1:<base64>
# FIELD_ENCRYPTION_OLD_KEYS=

# Mailer (SMTP)
# Defaults target Mailpit locally (localhost:1025, no auth). For real sending,
# point MAIL_HOST/MAIL_USER/MAIL_PASS at your provider's SMTP credentials.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=School ERP
MAIL_FROM_ADDRESS=no-reply@school-erp.local
# Frontend base URL used to build activation / password-reset links. Links
# to school hosts take its protocol and port: http://<slug>.lvh.me:3000/…
# (signup, Google and school-switch redirects land there).
APP_URL=http://localhost:3000
# Platform root domain — tenant email links are built as {slug}.{ROOT_DOMAIN}
ROOT_DOMAIN=lvh.me
# Custom domains: the host schools CNAME their app domain to (default
# schools.${ROOT_DOMAIN}) and how many domains one school may add.
# CUSTOM_DOMAIN_CNAME_TARGET=schools.lvh.me
# CUSTOM_DOMAIN_MAX_PER_ORG=5

# CORS: comma-separated origins, required in production. `*.` matches one
# subdomain label, e.g. https://*.example.com for every school subdomain.
# Omit in development to allow any origin.
# CORS_ORIGIN=http://localhost:3000,http://*.lvh.me:3000

# Proxies allowed to set X-Forwarded-For (Express `trust proxy`): a hop
# count, true/false, or a list such as `loopback, 10.0.0.0/8`. Default:
# loopback and private networks. Use `false` if clients reach the API directly.
# The web-2 frontend calls the API from its server (the /api proxy) and sends
# the browser's address in X-Forwarded-For, so the frontend server must be
# on one of these networks (same machine, or a private network).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Rate limiting (global throttler; per-tenant + per-user/IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Health checks
HEALTH_DISK_PATH=/
HEALTH_DISK_THRESHOLD=0.9
HEALTH_MEMORY_HEAP_BYTES=314572800
HEALTH_MEMORY_RSS_BYTES=524288000

# Logging: fatal | error | warn | info | debug | trace | silent
# (default: debug, or info in production)
# LOG_LEVEL=debug

# Google sign-in (optional; the routes answer 404 until both are set).
# Authorized redirect URI in Google Cloud: ${APP_URL}/api/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
