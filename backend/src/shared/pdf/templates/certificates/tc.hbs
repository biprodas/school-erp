<div
  style='border:3px double #333;padding:14mm;min-height:250mm;position:relative'
>
  {{#if revoked}}
    <div
      style='position:absolute;top:110mm;left:0;right:0;text-align:center;font-size:48pt;color:rgba(200,0,0,.35);transform:rotate(-20deg)'
    >REVOKED</div>
  {{/if}}
  <div style='text-align:center'>
    <div style='font-size:18pt;font-weight:bold'>{{d.schoolName}}</div>
    {{#if d.schoolNameBn}}<div
        class='serif'
        style='font-size:14pt'
      >{{d.schoolNameBn}}</div>{{/if}}
    <div
      style='margin-top:8mm;font-size:16pt;font-weight:bold;text-decoration:underline'
    >Transfer Certificate</div>
    <div class='serif' style='font-size:13pt'>ছাড়পত্র</div>
  </div>
  <table style='margin-top:8mm;width:auto'><tr>
      <td style='padding-right:12mm'>Serial: <b>{{serial}}</b></td>
      <td>Date: <b>{{issuedOn}}</b></td>
    </tr></table>
  <p
    style='margin-top:10mm;font-size:12pt;line-height:1.9;text-align:justify'
  >This is to certify that
    <b>{{d.studentName}}</b>{{#if d.fatherName}}, son/daughter of
      {{d.fatherName}}{{/if}}{{#if d.motherName}} and {{d.motherName}}{{/if}},
    Student ID
    {{d.admissionNumber}}, was a student of this school{{#if d.className}}
      and studied in
      {{d.className}}{{#if d.sectionName}}
        ({{d.sectionName}}){{/if}}{{/if}}{{#if d.sessionName}}
      in the
      {{d.sessionName}}
      session{{/if}}.
    {{#if d.dob}}Date of birth: {{d.dob}}. {{/if}}{{#if d.leavingReason}}Reason
      for leaving:
      {{d.leavingReason}}.
    {{/if}}We wish the student every success.</p>
  {{#if d.remarks}}<p style='font-size:11pt'>Remarks: {{d.remarks}}</p>{{/if}}
  <div style='position:absolute;bottom:14mm;left:14mm;width:32mm'>{{{qr}}}<div
      style='font-size:7pt;margin-top:1mm;word-break:break-all'
    >{{d.verifyUrl}}</div></div>
  <div
    style='position:absolute;bottom:20mm;right:14mm;text-align:center;border-top:1px solid #333;padding-top:2mm;width:60mm'
  >Head of the institution</div>
</div>