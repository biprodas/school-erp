NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_API_URL=http://localhost:3900/api

# Do NOT set AUTH_URL when using multi-tenant subdomains (*.lvh.me) — it pins
# auth callbacks to a single host and breaks login on other subdomains.
AUTH_SECRET=cfa531260aef3f0229f14085ea437f41
# Trust the incoming host header — required for *.lvh.me tenant subdomains in dev
AUTH_TRUST_HOST=true
# Share the session cookie across all tenant subdomains. Use a leading dot.
# Dev: .lvh.me   Prod: .yourdomain.com   (leave unset for plain localhost)
AUTH_COOKIE_DOMAIN=.lvh.me