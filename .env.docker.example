# Optional overrides for docker-compose.yml. Copy to `.env` (repo root) only
# if you need to change a default. Keep backend/.env.development in sync.

# Postgres (host port 5433 avoids clashing with a native Postgres on 5432)
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_erp

# pgAdmin (http://localhost:5050)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@school-erp.dev
PGADMIN_PASSWORD=admin

# Redis + RedisInsight (http://localhost:5540)
REDIS_PORT=6379
REDIS_INSIGHT_PORT=5540

# MinIO (S3 API :9000, console http://localhost:9001); keep S3_* in
# backend/.env.development in sync
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=school-erp

# Mailpit (SMTP 1025, web UI http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
