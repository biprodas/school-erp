# Copy to .env.local. Server-only values are never sent to the browser.
# Code reads these only through src/config/ (app-config, api-config,
# auth-config, site-config); nothing else touches process.env.

# Backend origin, without /api (server-only; the browser goes through /api).
API_URL=http://localhost:3900

# Seals the session cookie. 32+ random characters (server-only), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-32-or-more-random-characters

# School hosts are <slug>.<root domain>; lvh.me resolves to 127.0.0.1.
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me
NEXT_PUBLIC_ADMIN_HOST=admin.lvh.me

# Port added to absolute links in development; leave empty in production.
NEXT_PUBLIC_APP_PORT=3000

# The marketing site's address, the base of absolute metadata URLs
# (appConfig.appUrl, siteConfig.siteUrl). Defaults to http://<root domain>:<port>.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Reverse proxies in front of this server that append to X-Forwarded-For
# (Caddy, nginx, a load balancer). The client address is the entry this far
# from the end; anything further left is whatever the client claimed.
# Production must run behind at least one. Default 1.
# TRUSTED_PROXY_HOPS=1
